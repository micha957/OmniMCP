OMNIMCP_WEB_ADDR=127.0.0.1:8090
# Leave empty for local use; set a value to require Bearer auth on /mcp and the extension socket.
OMNIMCP_API_TOKEN=
OMNIMCP_BROWSER_MODE=extension
OMNIMCP_HEADLESS=false
OMNIMCP_DATA_DIR=data
OMNIMCP_ARTIFACT_DIR=data/artifacts
# Opens the write-confirmation API. Keep it away from AI clients; required for remote review.
OMNIMCP_APPROVAL_TOKEN=
# Tools that run without a confirmation click, as tool:limit per account per 24 hours.
# Empty means every write waits for a person. Duplicates and unknown results are never resent.
OMNIMCP_AUTO_APPROVE=
# Managed mode runs one browser with one tab per platform and reconnects after a restart.
OMNIMCP_CHROME_PORT=9333
# Browser binary; empty prefers installed Google Chrome.
OMNIMCP_CHROME_BIN=
# Default per-tool timeout (Go duration); long workflows such as publishing declare their own.
OMNIMCP_TOOL_TIMEOUT=2m

# Separate prelaunch agent workbench: go run ./cmd/agentops
OMNIMCP_AGENT_ADDR=127.0.0.1:8091
OMNIMCP_AGENT_STATE=data/agentops/state.json
# A Chat Completions compatible base URL ending in /v1; no trailing /chat/completions.
OMNIMCP_AGENT_BASE_URL=
# Select a model supported by that service. No model is selected implicitly.
OMNIMCP_AGENT_MODEL=
# Falls back to OPENAI_API_KEY when empty. Use a key intended for the configured service.
OMNIMCP_AGENT_API_KEY=
OMNIMCP_AGENT_MCP_URL=http://127.0.0.1:8090/mcp
# Falls back to OMNIMCP_API_TOKEN when empty.
OMNIMCP_AGENT_MCP_TOKEN=
