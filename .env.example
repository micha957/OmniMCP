OMNIMCP_WEB_ADDR=127.0.0.1:8090
# Leave empty for local use; set a value to require Bearer auth on /mcp and the extension socket.
OMNIMCP_API_TOKEN=
OMNIMCP_BROWSER_MODE=extension
OMNIMCP_HEADLESS=false
OMNIMCP_DATA_DIR=data
OMNIMCP_ARTIFACT_DIR=data/artifacts
# Default per-tool timeout (Go duration); long workflows such as publishing declare their own.
OMNIMCP_TOOL_TIMEOUT=2m
